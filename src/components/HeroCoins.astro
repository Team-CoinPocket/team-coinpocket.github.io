---
// 첫 화면 오른쪽에 떠 있는 동전 그림. 장식이라 화면 읽기 프로그램에는 숨긴다.
// x·y 는 그림 칸 안의 위치(%), size 는 지름(px), tilt 는 기울기(도), delay 는 흔들림 시작(초).
const coins = [
	{ x: 52, y: 14, size: 150, tilt: -14, delay: 0 },
	{ x: 16, y: 40, size: 104, tilt: 18, delay: -1.6 },
	{ x: 62, y: 58, size: 120, tilt: 8, delay: -3.1 },
	{ x: 28, y: 6, size: 64, tilt: 26, delay: -2.2 },
	{ x: 8, y: 76, size: 56, tilt: -22, delay: -0.8 },
	{ x: 86, y: 40, size: 48, tilt: -30, delay: -4 },
];
---

<div class="coins" aria-hidden="true">
	<!-- 동전 그림 한 개를 정의해 두고 아래에서 여러 번 가져다 쓴다 -->
	<svg width="0" height="0" class="defs">
		<defs>
			<!-- 옆면: 가운데가 밝은 원통 + 가는 톱니 줄 -->
			<linearGradient id="hc-edge" x1="0" x2="1" y1="0" y2="0">
				<stop offset="0" stop-color="#6b450f" />
				<stop offset=".22" stop-color="#b9852c" />
				<stop offset=".48" stop-color="#ecc673" />
				<stop offset=".72" stop-color="#a8731f" />
				<stop offset="1" stop-color="#5e3c0c" />
			</linearGradient>
			<pattern id="hc-reed" width="2.2" height="10" patternUnits="userSpaceOnUse">
				<rect width="0.9" height="10" fill="rgb(60 36 0 / .28)" />
			</pattern>
			<!-- 앞면 테두리(볼록)와 안쪽 바닥(오목): 빛 방향을 서로 반대로 -->
			<linearGradient id="hc-rim" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#fbe8ad" />
				<stop offset=".35" stop-color="#d9a748" />
				<stop offset=".6" stop-color="#f1d084" />
				<stop offset="1" stop-color="#a26e1d" />
			</linearGradient>
			<linearGradient id="hc-field" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#b98328" />
				<stop offset=".45" stop-color="#e0b257" />
				<stop offset=".7" stop-color="#cf9c42" />
				<stop offset="1" stop-color="#f1d28a" />
			</linearGradient>
			<radialGradient id="hc-spec" cx=".32" cy=".3" r=".55">
				<stop offset="0" stop-color="#fff" stop-opacity=".4" />
				<stop offset="1" stop-color="#fff" stop-opacity="0" />
			</radialGradient>
			<symbol id="hc-coin" viewBox="0 0 100 100">
				<ellipse cx="50" cy="56" rx="46" ry="34" fill="url(#hc-edge)" />
				<rect x="4" y="46" width="92" height="10" fill="url(#hc-edge)" />
				<ellipse cx="50" cy="56" rx="46" ry="34" fill="url(#hc-reed)" />
				<rect x="4" y="46" width="92" height="10" fill="url(#hc-reed)" />
				<ellipse cx="50" cy="46" rx="46" ry="34" fill="url(#hc-rim)" />
				<ellipse cx="50" cy="46.6" rx="39.5" ry="29" fill="rgb(90 55 5 / .35)" />
				<ellipse cx="50" cy="46" rx="39" ry="28.6" fill="url(#hc-field)" />
				<!-- 테두리 안쪽 점 무늬와 가는 동심원 -->
				<ellipse cx="50" cy="46" rx="35" ry="25.6" fill="none" stroke="rgb(100 62 8 / .5)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="0 3" />
				<ellipse cx="50" cy="46" rx="26" ry="19" fill="none" stroke="rgb(255 240 200 / .25)" stroke-width=".5" />
				<ellipse cx="50" cy="46" rx="20" ry="14.6" fill="none" stroke="rgb(255 240 200 / .2)" stroke-width=".5" />
				<ellipse cx="50" cy="46" rx="46" ry="34" fill="url(#hc-spec)" />
			</symbol>
		</defs>
	</svg>
	<div class="glow"></div>
	{coins.map((c) => (
		<div
			class="coin"
			style={`left:${c.x}%;top:${c.y}%;--size:${c.size}px;--tilt:${c.tilt}deg;animation-delay:${c.delay}s`}
		>
			<svg viewBox="0 0 100 100"><use href="#hc-coin" /></svg>
		</div>
	))}
</div>

<style>
	.coins {
		position: relative;
		width: 100%;
		aspect-ratio: 1;
		max-width: 460px;
		margin-inline: auto;
	}
	.glow {
		position: absolute;
		inset: 12%;
		border-radius: 50%;
		background: radial-gradient(circle, var(--glow) 0%, transparent 70%);
		filter: blur(20px);
	}
	.coin {
		position: absolute;
		width: var(--size);
		translate: -50% 0;
		rotate: var(--tilt);
		animation: bob 6s ease-in-out infinite;
		filter: drop-shadow(0 18px 22px rgb(90 55 0 / 0.25));
	}
	.coin svg { display: block; width: 100%; height: auto; }
	.defs { position: absolute; }

	@keyframes bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-14px); }
	}
	@media (max-width: 860px) {
		.coins { max-width: 300px; }
		.coin { width: calc(var(--size) * 0.65); }
	}
	@media (prefers-reduced-motion: reduce) {
		.coin { animation: none; }
	}
</style>
