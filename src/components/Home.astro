---
import Base from '../layouts/Base.astro';
import HeroCoins from './HeroCoins.astro';
import ProjectCard from './ProjectCard.astro';
import SocialLinks from './SocialLinks.astro';
import { t, contactEmail, type Lang } from '../i18n';
import { projects } from '../projects';
import { activeSocials } from '../socials';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang];
const sections = Object.entries(s.sections);
// 첫 화면 제목 위 작은 글씨: 다른 언어의 팀 이름
const otherName = lang === 'ko' ? t.en.teamName : t.ko.teamName;
const firstSection = sections[0];
---

<Base lang={lang}>
	<section class="hero">
		<div class="backdrop" aria-hidden="true"></div>
		<div class="wrap hero-grid">
			<div class="hero-text">
				<p class="eyebrow" lang={lang === 'ko' ? 'en' : 'ko'} data-reveal>{otherName}</p>
				<h1 data-reveal style="--delay:.08s">{s.teamName}</h1>
				{s.tagline && <p class="tagline" data-reveal style="--delay:.16s">{s.tagline}</p>}
				{activeSocials.length > 0 && (
					<div class="hero-socials" data-reveal style="--delay:.24s"><SocialLinks /></div>
				)}
			</div>
			<div class="hero-art" data-reveal style="--delay:.2s">
				<HeroCoins />
			</div>
		</div>
		{firstSection && (
			<a class="scroll-cue" href={`#${firstSection[0]}`} aria-label={firstSection[1].title}>
				<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
					<path d="M10 4v12m0 0-5-5m5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</a>
		)}
	</section>

	{sections.map(([id, sec], i) => (
		<section id={id} class="block">
			<div class="wrap">
				<header class="block-head" data-reveal>
					<span class="index">{String(i + 1).padStart(2, '0')}</span>
					<h2>{sec.title}</h2>
					{sec.body && <p>{sec.body}</p>}
				</header>
				{id === 'projects' && (
					<div class="projects">
						{projects.map((p) => <ProjectCard project={p} lang={lang} />)}
					</div>
				)}
				{id === 'contact' && (
					<a class="mail" href={`mailto:${contactEmail}`} data-reveal>
						<span class="mail-icon" aria-hidden="true">
							<svg width="24" height="24" viewBox="0 0 24 24">
								<rect x="3" y="5" width="18" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
								<path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</span>
						<span class="mail-addr">
							{contactEmail.split('@')[0]}<wbr />@{contactEmail.split('@')[1]}
						</span>
						<svg class="mail-arrow" width="22" height="22" viewBox="0 0 16 16" aria-hidden="true">
							<path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				)}
			</div>
		</section>
	))}
</Base>

<style>
	.hero {
		position: relative;
		min-height: min(78svh, 760px);
		display: grid;
		align-items: center;
		padding-block: 48px 96px;
		overflow: hidden;
		isolation: isolate;
	}
	.backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		mask-image: linear-gradient(to bottom, #000 60%, transparent);
		-webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent);
		background:
			radial-gradient(60% 60% at 78% 40%, var(--glow), transparent 70%),
			radial-gradient(40% 50% at 10% 90%, rgb(160 110 230 / 0.12), transparent 70%);
	}
	/* 은은한 점 무늬, 아래로 갈수록 사라짐 */
	.backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(var(--line) 1px, transparent 1px);
		background-size: 22px 22px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		align-items: center;
		gap: 40px;
	}
	@media (max-width: 860px) {
		.hero { min-height: auto; padding-block: 56px 96px; }
		.hero-grid { grid-template-columns: 1fr; gap: 24px; }
		.hero-art { order: -1; }
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 20px;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent-ink);
	}
	.eyebrow:lang(ko) { letter-spacing: 0.06em; }
	.eyebrow::before {
		content: '';
		width: 28px;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
	}
	h1 {
		margin: 0;
		font-size: clamp(3.4rem, 10vw, 7.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.045em;
	}
	.tagline {
		max-width: 26em;
		margin: 28px 0 0;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.55;
		color: var(--muted);
	}

	.hero-socials { margin-top: 32px; }

	.scroll-cue {
		position: absolute;
		left: 50%;
		bottom: 28px;
		translate: -50% 0;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--surface) 70%, transparent);
		color: var(--muted);
		transition: color 0.2s, border-color 0.2s;
		animation: nudge 2.4s ease-in-out infinite;
	}
	.scroll-cue:hover { color: var(--fg); border-color: var(--accent); }
	@keyframes nudge {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(5px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.scroll-cue { animation: none; }
	}

	.block { padding-top: 96px; }
	.block-head { margin-bottom: 40px; }
	.index {
		display: block;
		margin-bottom: 8px;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--accent-ink);
		font-variant-numeric: tabular-nums;
	}
	.block-head h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.15;
	}
	.block-head p { max-width: 36em; margin: 12px 0 0; color: var(--muted); font-size: 1.05rem; }
	.projects { display: grid; gap: 32px; }

	.mail {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		max-width: 100%;
		padding: 12px 20px 12px 12px;
		border-radius: 18px;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		text-decoration: none;
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s;
	}
	.mail.is-in:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
	.mail-icon {
		display: grid;
		place-items: center;
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		background: var(--accent);
		color: var(--on-accent);
	}
	.mail-icon svg { width: 20px; height: 20px; }
	.mail-addr {
		min-width: 0;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}
	.mail-arrow { flex: none; width: 18px; height: 18px; color: var(--muted); transition: transform 0.2s, color 0.2s; }
	.mail:hover .mail-arrow { color: var(--fg); transform: translate(2px, -2px); }
	@media (max-width: 380px) {
		.mail-addr { font-size: 1rem; }
		.mail-arrow { display: none; }
	}
</style>
