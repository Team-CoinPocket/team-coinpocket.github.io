---
import Base from '../layouts/Base.astro';
import ProjectCard from './ProjectCard.astro';
import { t, type Lang } from '../i18n';
import { projects } from '../projects';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang];
const sections = Object.entries(s.sections);
---

<Base lang={lang}>
	<section class="hero">
		<h1>{s.teamName}</h1>
		{s.tagline && <p>{s.tagline}</p>}
	</section>

	{sections.map(([id, sec]) => (
		<section id={id} class="block">
			<h2>{sec.title}</h2>
			{sec.body && <p>{sec.body}</p>}
			{id === 'projects' && (
				<div class="projects">
					{projects.map((p) => <ProjectCard project={p} lang={lang} />)}
				</div>
			)}
		</section>
	))}
</Base>

<style>
	.hero { padding: 96px 0 64px; }
	.hero h1 {
		margin: 0;
		font-size: clamp(2.4rem, 7vw, 4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.hero p { margin: 16px 0 0; font-size: 1.2rem; color: var(--muted); }
	.block { padding: 32px 0; border-top: 1px solid var(--line); }
	.block h2 { margin: 0 0 8px; font-size: 1.1rem; color: var(--accent); }
	.block > p { margin: 0; color: var(--muted); }
	.block h2 + .projects { margin-top: 16px; }
	.projects { display: grid; gap: 40px; }
</style>
