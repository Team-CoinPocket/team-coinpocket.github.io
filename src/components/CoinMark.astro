---
// 동전지갑 로고 동전. 머리말·꼬리말에 쓴다. 탭 아이콘(public/favicon.svg)도 같은 그림이니 바꾸면 같이 고친다.
interface Props {
	size?: number;
}

const { size = 28 } = Astro.props;
// 한 페이지에 여러 번 나오므로 색 번짐(gradient) 이름이 겹치지 않게 한다.
const id = `cm-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="coin-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<defs>
		<linearGradient id={`${id}-face`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#f3c96b" />
			<stop offset="1" stop-color="#dfa646" />
		</linearGradient>
	</defs>
	<circle cx="16" cy="16" r="15" fill={`url(#${id}-face)`} />
	<circle cx="16" cy="16" r="11" fill="none" stroke="#a87322" stroke-opacity=".45" stroke-width="1.2" />
	<rect x="11" y="14.6" width="10" height="2.8" rx="1.4" fill="#9a6418" />
</svg>

<style>
	.coin-mark { display: block; flex: none; }
</style>
