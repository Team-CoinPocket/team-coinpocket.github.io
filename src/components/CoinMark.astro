---
// 동전지갑 로고 동전. 머리말·꼬리말에 쓴다.
interface Props {
	size?: number;
}

const { size = 28 } = Astro.props;
---

<svg class="coin-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<circle cx="16" cy="16" r="15" fill="#c98b22" />
	<circle cx="16" cy="15" r="14" fill="#f2b53a" />
	<circle cx="16" cy="15" r="10" fill="none" stroke="#d99a2b" stroke-width="2" />
	<rect x="12" y="13.5" width="8" height="3" rx="1.5" fill="#c98b22" />
	<path d="M8.5 9.5a9.5 9.5 0 0 1 5-4" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.6" stroke-linecap="round" />
</svg>

<style>
	.coin-mark { display: block; flex: none; }
</style>
