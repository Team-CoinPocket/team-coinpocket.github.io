---
// 동전지갑 로고 동전. 머리말·꼬리말에 쓴다. 탭 아이콘(public/favicon.svg)도 같은 그림이니 바꾸면 같이 고친다.
interface Props {
	size?: number;
}

const { size = 28 } = Astro.props;
// 한 페이지에 여러 번 나오므로 색 번짐(gradient) 이름이 겹치지 않게 한다.
const id = `cm-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="coin-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<defs>
		<linearGradient id={`${id}-rim`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#fbe5a4" />
			<stop offset=".5" stop-color="#d6a446" />
			<stop offset="1" stop-color="#8f5f17" />
		</linearGradient>
		<linearGradient id={`${id}-field`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#c08a2f" />
			<stop offset=".55" stop-color="#e2b65c" />
			<stop offset="1" stop-color="#f4d68e" />
		</linearGradient>
	</defs>
	<circle cx="16" cy="16" r="15" fill={`url(#${id}-rim)`} />
	<circle cx="16" cy="16" r="14.5" fill="none" stroke="rgb(100 65 10 / .45)" />
	<circle cx="16" cy="16" r="11.5" fill={`url(#${id}-field)`} />
	<circle cx="16" cy="16" r="11.5" fill="none" stroke="rgb(90 55 5 / .35)" stroke-width=".8" />
	<rect x="10.5" y="15.2" width="11" height="2.6" rx="1.3" fill="rgb(255 238 190 / .7)" />
	<rect x="10.5" y="14.2" width="11" height="2.6" rx="1.3" fill="#7d5214" />
</svg>

<style>
	.coin-mark { display: block; flex: none; }
</style>
