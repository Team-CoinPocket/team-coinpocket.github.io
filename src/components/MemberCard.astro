---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n';
import type { Member } from '../team';

interface Props {
	member: Member;
	lang: Lang;
}

const { member: m, lang } = Astro.props;
const name = m.name[lang];
const now = m.now?.[lang] ?? [];
---

<article class="member" data-reveal>
	<div class="stage" aria-hidden="true">
		{m.image ? (
			<div class="photo"><Image src={m.image} alt="" width={192} height={192} /></div>
		) : (
			<div class="coin"><span>{[...name][0]}</span></div>
		)}
	</div>
	<div class="info">
		{m.badge && <p class="badge">{m.badge[lang]}</p>}
		<h3>{name}</h3>
		<p class="roles">
			{m.roles[lang].map((r) => <span>{r}</span>)}
		</p>
		{now.length > 0 && (
			<div class="now">
				<p class="now-label">{t[lang].nowLabel}</p>
				<ul class="chips">
					{now.map((r) => <li>{r}</li>)}
				</ul>
			</div>
		)}
	</div>
</article>

<style>
	.member {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		text-align: center;
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s, box-shadow 0.4s;
	}
	.member.is-in:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		box-shadow: var(--shadow), 0 24px 48px -24px var(--glow);
	}

	/* 위쪽 무대: 금빛 번짐 + 점 무늬 */
	.stage {
		position: relative;
		display: grid;
		place-items: center;
		padding: 36px 0 28px;
		background:
			radial-gradient(60% 80% at 50% 45%, var(--glow), transparent 75%),
			radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 14px 14px;
		border-bottom: 1px solid var(--line);
		perspective: 600px;
	}

	/* 동전: 차분한 금색 한 겹 + 얇은 안쪽 테두리 + 아래쪽 두께 */
	.coin {
		position: relative;
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: linear-gradient(180deg, #f0c463, #d9a141);
		box-shadow:
			0 10px 20px -10px rgb(90 55 0 / 0.55),
			inset 0 -3px 0 rgb(150 95 20 / 0.45),
			inset 0 1px 0 rgb(255 240 200 / 0.6);
		transition: transform 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
		transform-style: preserve-3d;
	}
	.coin::before {
		content: '';
		position: absolute;
		inset: 9px;
		border-radius: 50%;
		border: 1.5px solid rgb(150 95 20 / 0.35);
	}
	/* 반짝임 */
	.coin::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.35) 47%, transparent 58%);
		background-size: 250% 100%;
		background-position: 100% 0;
		transition: background-position 0.9s;
	}
	.coin span {
		position: relative;
		z-index: 1;
		font-size: 1.9rem;
		font-weight: 700;
		line-height: 1;
		color: #8d5c14;
	}
	.member:hover .coin { transform: rotateY(360deg); }
	.member:hover .coin::after { background-position: -50% 0; }

	.photo {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: 0 0 0 4px var(--surface), 0 0 0 6px #dfa646, 0 14px 24px -10px rgb(0 0 0 / 0.4);
	}
	.photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

	.info {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 20px 20px 22px;
	}
	.badge {
		margin: 0 0 8px;
		padding: 2px 10px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 18%, var(--surface));
		border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
		color: var(--accent-ink);
		font-size: 0.75rem;
		font-weight: 700;
	}
	h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.roles {
		margin: 6px 0 0;
		font-size: 0.88rem;
		color: var(--muted);
	}
	.roles span { display: inline-block; white-space: nowrap; }
	.roles span + span::before {
		content: '·';
		margin: 0 6px;
		opacity: 0.6;
	}

	/* 현재 프로젝트 업무: 카드 아래쪽에 붙는다 */
	.now {
		width: 100%;
		margin-top: auto;
		padding-top: 16px;
	}
	.now-label {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 10px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.now-label::before, .now-label::after {
		content: '';
		flex: 1;
		border-top: 1px dashed var(--line);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--surface-2);
		border: 1px solid var(--line);
		font-size: 0.78rem;
		font-weight: 600;
		white-space: nowrap;
	}

	@media (max-width: 560px) {
		.stage { padding: 28px 0 20px; }
		.coin, .photo { width: 76px; height: 76px; }
		.coin span { font-size: 1.5rem; }
		.coin::before { inset: 7px; }
		.info { padding: 14px 10px 16px; }
		.now { padding-top: 12px; }
		.chips li { padding: 2px 8px; font-size: 0.72rem; }
		h3 { font-size: 1.1rem; }
		.roles { font-size: 0.8rem; }
		.roles span { display: block; }
		.roles span + span::before { content: none; }
	}
	/* 움직임 줄이기를 켠 사람: 뒤집지 않고 빛만 한 번 지나가며 살짝 밝아진다 */
	@media (prefers-reduced-motion: reduce) {
		.coin { transition: filter 0.4s; }
		.member:hover .coin { transform: none; filter: brightness(1.1); }
	}
</style>
