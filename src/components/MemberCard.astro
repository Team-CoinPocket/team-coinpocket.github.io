---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import type { Member } from '../team';

interface Props {
	member: Member;
	lang: Lang;
}

const { member: m, lang } = Astro.props;
const name = m.name[lang];
---

<article class="member" data-reveal>
	<div class="avatar" aria-hidden="true">
		{m.image ? <Image src={m.image} alt="" width={160} height={160} /> : <span>{[...name][0]}</span>}
	</div>
	<h3>{name}</h3>
	<ul class="roles">
		{m.roles[lang].map((r) => <li>{r}</li>)}
	</ul>
</article>

<style>
	.member {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 24px;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s;
	}
	.member.is-in:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
	/* 사진이 없을 때: 이름 첫 글자를 새긴 동전 */
	.avatar {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		margin-bottom: 20px;
		border-radius: 50%;
		overflow: hidden;
		background: #f2b53a;
		box-shadow: inset 0 0 0 5px #f2b53a, inset 0 0 0 7px #d99a2b, inset 0 -4px 0 7px #c98b22, 0 8px 20px -8px var(--glow);
		color: #6e4609;
		font-size: 1.7rem;
		font-weight: 800;
	}
	.avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
	h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.roles {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}
	.roles li {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--surface-2);
		border: 1px solid var(--line);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--muted);
		white-space: nowrap;
	}
	.roles li:first-child {
		background: color-mix(in srgb, var(--accent) 18%, var(--surface));
		border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
		color: var(--accent-ink);
	}
	@media (max-width: 560px) {
		.member { padding: 18px 16px; }
		.avatar { width: 60px; height: 60px; margin-bottom: 16px; font-size: 1.4rem; }
		h3 { font-size: 1.15rem; }
	}
</style>
