---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import type { Member } from '../team';

interface Props {
	member: Member;
	lang: Lang;
}

const { member: m, lang } = Astro.props;
const name = m.name[lang];
const [mainRole, ...otherRoles] = m.roles[lang];
---

<article class="member" data-reveal>
	<div class="stage" aria-hidden="true">
		{m.image ? (
			<div class="photo"><Image src={m.image} alt="" width={192} height={192} /></div>
		) : (
			<div class="coin"><span>{[...name][0]}</span></div>
		)}
	</div>
	<div class="info">
		<h3>{name}</h3>
		<p class="roles">
			{mainRole && <span class="main">{mainRole}</span>}
			{otherRoles.map((r) => <span>{r}</span>)}
		</p>
	</div>
</article>

<style>
	.member {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		text-align: center;
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.4s, box-shadow 0.4s;
	}
	.member.is-in:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
		box-shadow: var(--shadow), 0 24px 48px -24px var(--glow);
	}

	/* 위쪽 무대: 금빛 번짐 + 점 무늬 */
	.stage {
		position: relative;
		display: grid;
		place-items: center;
		padding: 36px 0 28px;
		background:
			radial-gradient(60% 80% at 50% 45%, var(--glow), transparent 75%),
			radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 14px 14px;
		border-bottom: 1px solid var(--line);
		perspective: 600px;
	}

	/* 동전: 톱니 테두리 + 빛 받는 앞면 + 새긴 글자 */
	.coin {
		position: relative;
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		background: repeating-conic-gradient(#c98b22 0deg 3deg, #e6a937 3deg 6deg);
		box-shadow: 0 14px 24px -10px rgb(120 70 0 / 0.55), 0 0 0 1px rgb(150 95 10 / 0.4);
		transition: transform 0.9s cubic-bezier(0.3, 0.7, 0.2, 1);
		transform-style: preserve-3d;
	}
	.coin::before {
		content: '';
		position: absolute;
		inset: 6px;
		border-radius: 50%;
		background: radial-gradient(circle at 34% 28%, #ffe08a 0%, #f6c04a 38%, #e3a330 75%, #c98b22 100%);
		box-shadow:
			inset 0 0 0 5px rgb(255 220 130 / 0.35),
			inset 0 0 0 6px rgb(170 110 20 / 0.45),
			inset 0 -3px 6px rgb(140 85 10 / 0.35);
	}
	/* 반짝임 */
	.coin::after {
		content: '';
		position: absolute;
		inset: 6px;
		border-radius: 50%;
		background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.55) 45%, transparent 60%);
		background-size: 250% 100%;
		background-position: 100% 0;
		transition: background-position 0.9s;
	}
	.coin span {
		position: relative;
		z-index: 1;
		font-size: 2.1rem;
		font-weight: 800;
		line-height: 1;
		color: #9a650f;
		text-shadow: 0 1px 0 rgb(255 236 180 / 0.9), 0 -1px 0 rgb(110 65 0 / 0.35);
	}
	.member:hover .coin { transform: rotateY(360deg); }
	.member:hover .coin::after { background-position: -50% 0; }

	.photo {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: 0 0 0 4px var(--surface), 0 0 0 6px #e6a937, 0 14px 24px -10px rgb(0 0 0 / 0.4);
	}
	.photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

	.info { padding: 20px 20px 24px; }
	h3 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.roles {
		margin: 6px 0 0;
		font-size: 0.88rem;
		color: var(--muted);
	}
	.roles span { display: inline-block; white-space: nowrap; }
	.roles span + span::before {
		content: '·';
		margin: 0 6px;
		opacity: 0.6;
	}
	.roles .main { font-weight: 700; color: var(--accent-ink); }

	@media (max-width: 560px) {
		.stage { padding: 28px 0 20px; }
		.coin, .photo { width: 76px; height: 76px; }
		.coin span { font-size: 1.7rem; }
		.info { padding: 14px 12px 18px; }
		h3 { font-size: 1.1rem; }
		.roles { font-size: 0.8rem; }
		.roles span { display: block; }
		.roles span + span::before { content: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.coin, .coin::after { transition: none; }
		.member:hover .coin { transform: none; }
	}
</style>
