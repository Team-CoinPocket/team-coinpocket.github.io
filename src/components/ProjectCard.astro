---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n';
import type { Project } from '../projects';

interface Props {
	project: Project;
	lang: Lang;
}

const { project: p, lang } = Astro.props;
const s = t[lang];
const date = new Date(p.released).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
	year: 'numeric',
	month: 'long',
	timeZone: 'UTC',
});
---

<article class="card">
	<a href={p.link.url} target="_blank" rel="noopener" class="thumb">
		<Image src={p.image} alt={p.name[lang]} />
	</a>
	<div class="body">
		<h3>{p.name[lang]}</h3>
		<p class="meta">{s.released} {date} · {p.platforms.join(', ')}</p>
		<p class="summary">{p.summary[lang]}</p>
		<a class="button" href={p.link.url} target="_blank" rel="noopener">{s.viewOn(p.link.label)} ↗</a>
	</div>
</article>

<style>
	.card {
		display: grid;
		grid-template-columns: minmax(0, 460px) 1fr;
		gap: 24px;
		align-items: start;
	}
	@media (max-width: 720px) {
		.card { grid-template-columns: 1fr; }
	}
	.thumb img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		border: 1px solid var(--line);
	}
	h3 { margin: 0; font-size: 1.4rem; }
	.meta { margin: 4px 0 12px; font-size: 0.9rem; color: var(--muted); }
	.summary { margin: 0 0 20px; }
	.button {
		display: inline-block;
		padding: 8px 16px;
		border-radius: 8px;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
	}
	.button:hover { filter: brightness(1.08); }
</style>
