---
import CoinMark from '../components/CoinMark.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { activeSocials } from '../socials';
import { languages, homePath, t, type Lang } from '../i18n';

interface Props {
	lang: Lang;
	title?: string;
}

const { lang, title } = Astro.props;
const s = t[lang];
const pageTitle = title ? `${title} · ${s.teamName}` : s.teamName;
const langs = Object.keys(languages) as Lang[];
const sections = Object.entries(s.sections);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{s.tagline && <meta name="description" content={s.tagline} />}
		<meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e0d12" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{langs.map((l) => (
			<link rel="alternate" hreflang={l} href={new URL(homePath[l], Astro.site)} />
		))}
		<!-- 글꼴: Pretendard (한글·영문 모두) -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
		/>
		<!-- 자바스크립트가 켜져 있을 때만 스크롤 등장 효과를 쓴다 -->
		<script is:inline>document.documentElement.classList.add('js');</script>
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap bar">
				<a class="brand" href={homePath[lang]}>
					<CoinMark />
					<span>{s.teamName}</span>
				</a>
				<div class="right">
					<nav class="sections">
						{sections.map(([id, sec]) => <a href={`#${id}`}>{sec.title}</a>)}
					</nav>
					<nav class="langs" aria-label="Language">
						{langs.map((l) => (
							<a href={homePath[l]} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
								{languages[l]}
							</a>
						))}
					</nav>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap foot">
				<div class="foot-brand">
					<a class="brand" href={homePath[lang]}>
						<CoinMark size={24} />
						<span>{s.teamName}</span>
					</a>
					<p>{s.footer}</p>
					{activeSocials.length > 0 && <div class="foot-socials"><SocialLinks /></div>}
				</div>
				<nav class="foot-langs" aria-label="Language">
					{langs.map((l) => (
						<a href={homePath[l]} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
							{languages[l]}
						</a>
					))}
				</nav>
			</div>
			<div class="wrap copy">© {new Date().getFullYear()} {t.en.teamName}</div>
		</footer>

		<script>
			// 스크롤해서 화면에 들어온 칸을 부드럽게 보여 준다.
			const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduce || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-in'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('is-in');
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px' },
				);
				items.forEach((el) => io.observe(el));
			}

			// 스크롤하면 머리말에 그림자를 넣는다.
			const header = document.querySelector('.site-header');
			const onScroll = () => header?.classList.toggle('is-scrolled', scrollY > 8);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #faf8f3;
		--surface: #ffffff;
		--surface-2: #f3f0e8;
		--fg: #17161a;
		--muted: #66636c;
		--line: rgb(23 22 26 / 0.09);
		--accent: #f2b53a;
		--accent-ink: #94600f;
		--on-accent: #231705;
		--glow: rgb(242 181 58 / 0.45);
		--shadow: 0 1px 2px rgb(23 22 26 / 0.04), 0 12px 32px -12px rgb(23 22 26 / 0.12);
		--radius: 24px;
		--header-h: 68px;
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0e0d12;
			--surface: #17161d;
			--surface-2: #1f1d26;
			--fg: #f3f0e9;
			--muted: #a3a0ab;
			--line: rgb(255 255 255 / 0.08);
			--accent-ink: #f2b94a;
			--glow: rgb(242 181 58 / 0.28);
			--shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 40px -16px rgb(0 0 0 / 0.6);
			color-scheme: dark;
		}
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 16px); }
	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
		font-feature-settings: 'ss05';
		line-height: 1.65;
		word-break: keep-all;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
	a { color: inherit; }
	::selection { background: var(--accent); color: var(--on-accent); }
	:focus-visible { outline: 2px solid var(--accent-ink); outline-offset: 3px; border-radius: 6px; }

	.wrap {
		width: 100%;
		max-width: 1120px;
		margin-inline: auto;
		padding-inline: 24px;
	}
	@media (max-width: 560px) {
		.wrap { padding-inline: 16px; }
	}

	/* 스크롤 등장 효과 */
	.js [data-reveal] {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
		transition-delay: var(--delay, 0s);
	}
	.js [data-reveal].is-in { opacity: 1; transform: none; }
	@media (prefers-reduced-motion: reduce) {
		.js [data-reveal] { opacity: 1; transform: none; transition: none; }
	}

	/* 머리말 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: saturate(1.6) blur(16px);
		-webkit-backdrop-filter: saturate(1.6) blur(16px);
		border-bottom: 1px solid transparent;
		transition: border-color 0.3s, box-shadow 0.3s;
	}
	.site-header.is-scrolled { border-bottom-color: var(--line); }
	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		height: var(--header-h);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.right { display: flex; align-items: center; gap: 20px; }
	.sections { display: flex; gap: 20px; font-size: 0.92rem; font-weight: 500; }
	.sections a { color: var(--muted); text-decoration: none; transition: color 0.2s; }
	.sections a:hover { color: var(--fg); }
	@media (max-width: 560px) {
		.sections { display: none; }
	}

	.langs {
		display: flex;
		padding: 3px;
		border-radius: 999px;
		background: var(--surface-2);
		border: 1px solid var(--line);
		font-size: 0.8rem;
		font-weight: 600;
	}
	.langs a {
		padding: 5px 12px;
		border-radius: 999px;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.2s, background 0.2s;
	}
	.langs a:hover { color: var(--fg); }
	.langs a[aria-current] {
		background: var(--surface);
		color: var(--fg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
	}

	/* 꼬리말 */
	.site-footer {
		margin-top: 120px;
		border-top: 1px solid var(--line);
		background: var(--surface-2);
	}
	.foot {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 24px;
		flex-wrap: wrap;
		padding-block: 48px 32px;
	}
	.foot-brand p { margin: 12px 0 0; color: var(--muted); font-size: 0.92rem; }
	.foot-socials { margin-top: 20px; }
	.foot-langs { display: flex; gap: 16px; font-size: 0.9rem; }
	.foot-langs a { color: var(--muted); text-decoration: none; }
	.foot-langs a:hover, .foot-langs a[aria-current] { color: var(--fg); }
	.copy {
		padding-block: 20px 32px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.8rem;
	}
</style>
